# Backend API URL (used by the Next.js frontend to call FastAPI)
# Local dev:
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Production (Vercel) — point at your Render backend:
# NEXT_PUBLIC_BACKEND_URL=https://autopost-1-ax2p.onrender.com
# NEXT_PUBLIC_API_URL=https://autopost-1-ax2p.onrender.com

NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
